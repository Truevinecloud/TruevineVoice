{
    "name":  "truevine-voice",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Truevine Voice - multi-tenant automated customer engagement platform",
    "license":  "UNLICENSED",
    "engines":  {
                    "node":  "\u003e=24.19.0 \u003c25",
                    "npm":  "\u003e=11.17.0 \u003c12"
                },
    "packageManager":  "npm@11.17.0",
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "dev":  "concurrently -k -n api,worker,web,admin -c blue,magenta,green,yellow \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\" \"npm:dev:admin\"",
                    "dev:api":  "npm run dev --workspace @truevine/api",
                    "dev:worker":  "npm run dev --workspace @truevine/worker",
                    "dev:web":  "npm run dev --workspace @truevine/web",
                    "dev:admin":  "npm run dev --workspace @truevine/admin",
                    "build":  "npm run build:packages \u0026\u0026 npm run build:apps",
                    "build:packages":  "npm run build --workspace @truevine/shared \u0026\u0026 npm run build --workspace @truevine/auth \u0026\u0026 npm run build --workspace @truevine/messaging \u0026\u0026 npm run build --workspace @truevine/database \u0026\u0026 npm run build --workspace @truevine/queue \u0026\u0026 npm run build --workspace @truevine/domain \u0026\u0026 npm run build --workspace @truevine/telephony",
                    "build:api": "npm run build --workspace @truevine/api",
                    "build:apps":  "npm run build --workspace @truevine/api \u0026\u0026 npm run build --workspace @truevine/worker \u0026\u0026 npm run build --workspace @truevine/web \u0026\u0026 npm run build --workspace @truevine/admin",
                    "start:api":  "npm run start --workspace @truevine/api",
                    "start:worker":  "npm run start --workspace @truevine/worker",
                    "start:web":  "npm run start --workspace @truevine/web",
                    "start:admin":  "npm run start --workspace @truevine/admin",
                    "lint":  "eslint .",
                    "lint:fix":  "eslint . --fix",
                    "format":  "prettier --write .",
                    "format:check":  "prettier --check .",
                    "typecheck":  "npm run build:packages \u0026\u0026 npm run typecheck --workspaces --if-present",
                    "pretest":  "npm run build:packages",
                    "test":  "npm run test --workspaces --if-present \u0026\u0026 npm run test:deployment",
                    "test:security:baseline": "npm run build:packages && npm run build:api && node infrastructure/scripts/run-security-tests.mjs --baseline",
                    "test:security": "npm run build:packages && npm run build:api && node infrastructure/scripts/run-security-tests.mjs",
                    "test:e2e":  "npm run test:e2e --workspaces --if-present",
                    "test:sensitive-audit:e2e": "npm run test:e2e --workspace @truevine/api -- sensitive-audit.e2e-spec.ts",
                    "test:tenant-isolation:e2e": "npm run test:e2e --workspace @truevine/api -- tenant-isolation.e2e-spec.ts",
                    "test:call-persistence:e2e": "npm run test:e2e --workspace @truevine/api -- call-persistence.e2e-spec.ts",
                    "prisma:migrate:diff": "prisma migrate diff --config packages/database/prisma.config.ts",
                    "test:billing:e2e": "npm run test:e2e --workspace @truevine/api -- billing.e2e-spec.ts",
                    "test:w2-02:migration": "bash infrastructure/scripts/w2-02-migration-rehearsal.sh",
                    "infra:up":  "docker compose up -d --wait",
                    "infra:down":  "docker compose down",
                    "infra:restart":  "docker compose restart",
                    "infra:logs":  "docker compose logs -f",
                    "infra:ps":  "docker compose ps",
                    "infra:reset":  "docker compose down --volumes",
                    "db:reset":  "npm run infra:reset \u0026\u0026 npm run infra:up",
                    "provision:owner":  "node infrastructure/scripts/provision-owner-cli.mjs",
                    "recover:qa-owner": "node infrastructure/scripts/recover-qa-owner.mjs",
                    "test:qa-owner-recovery": "vitest run --config infrastructure/vitest.config.mts infrastructure/scripts/recover-qa-owner.spec.ts",
                    "lint:qa-owner-recovery": "eslint infrastructure/scripts/recover-qa-owner.mjs infrastructure/scripts/recover-qa-owner.spec.ts infrastructure/scripts/test-qa-owner-recovery-linux.mjs",
                    "test:qa-owner-recovery:linux": "node infrastructure/scripts/test-qa-owner-recovery-linux.mjs",
                    "bootstrap:platform-owner": "node infrastructure/scripts/bootstrap-platform-owner.mjs",
                    "test:platform-owner-bootstrap:unit": "vitest run --config infrastructure/vitest.config.mts infrastructure/scripts/bootstrap-platform-owner.spec.ts",
                    "test:platform-owner-bootstrap:linux": "node infrastructure/scripts/run-platform-owner-bootstrap-linux.mjs",
                    "test:platform-owner-bootstrap:e2e": "npm run build:packages && npm run test:e2e --workspace @truevine/api -- platform-owner-bootstrap.e2e-spec.ts",
                    "provision:operations-admin-uat": "node infrastructure/scripts/provision-operations-admin-uat.mjs",
                    "test:uat-provisioning": "node infrastructure/scripts/rbac-007-provisioning-rehearsal.mjs",
                     "verify:journey":  "node infrastructure/scripts/verify-activation-journey.mjs",
                     "verify:boundaries":  "node infrastructure/scripts/verify-security-boundaries.mjs",
                     "verify:frontend":  "node infrastructure/scripts/verify-frontend.mjs",
                    "prisma:generate":  "npm run prisma:generate --workspace @truevine/database",
                    "prisma:validate":  "npm run prisma:validate --workspace @truevine/database",
                    "prisma:migrate:dev":  "npm run prisma:migrate:dev --workspace @truevine/database",
                    "prisma:migrate:deploy":  "npm run prisma:migrate:deploy --workspace @truevine/database",
                    "prisma:migrate:status": "npm run prisma:migrate:status --workspace @truevine/database",
                    "prisma:studio":  "npm run prisma:studio --workspace @truevine/database",
                    "ci:setup-npm":  "node infrastructure/scripts/setup-npm.mjs",
                    "test:deployment":  "vitest run --config infrastructure/vitest.config.mts \u0026\u0026 npm run test:db-verify \u0026\u0026 npm run test:backup",
                    "test:db-verify":  "node infrastructure/scripts/run-db-verify-tests.mjs",
                    "test:restore-integration": "node infrastructure/scripts/run-restore-integration.mjs",
                    "test:rbac-ci:checks": "vitest run --config infrastructure/vitest.config.mts infrastructure/scripts/rbac-database-ci.spec.ts",
                    "test:restore-integration:checks": "vitest run --config infrastructure/vitest.config.mts infrastructure/scripts/restore-integration.spec.ts",
                    "test:backup":  "node infrastructure/scripts/run-backup-tests.mjs",
                    "test:rehearsal":  "node infrastructure/scripts/run-rbac-001-rehearsal.mjs",
                    "deploy:release":  "bash infrastructure/scripts/deploy.sh",
                    "deploy:rollback":  "bash infrastructure/scripts/deploy.sh --rollback",
                    "deploy:verify":  "node infrastructure/scripts/verify-deployment.mjs",
                    "qa:matrix": "npm run build:packages && node infrastructure/scripts/qa-role-matrix.mjs",
                    "qa:provision": "node infrastructure/scripts/qa-role-test-kit.mjs",
                    "test:qa-role-kit": "vitest run --config infrastructure/vitest.config.mts infrastructure/scripts/qa-role-test-kit.spec.ts",
                    "test:account-seeder": "vitest run --config infrastructure/vitest.config.mts infrastructure/scripts/test-account-seeder.spec.ts",
                    "test-accounts:seed": "node infrastructure/scripts/test-account-seeder.mjs seed",
                    "test-accounts:verify": "node infrastructure/scripts/test-account-seeder.mjs verify",
                    "test-accounts:disable": "node infrastructure/scripts/test-account-seeder.mjs disable",
                    "rollout:test-accounts": "node infrastructure/scripts/production-test-rollout.mjs",
                    "test:production-rollout": "vitest run --config infrastructure/vitest.config.mts infrastructure/scripts/production-test-rollout.spec.ts infrastructure/scripts/production-test-http.spec.ts",
                    "test:production-rollout:e2e": "npm run build:packages && npm run test:e2e --workspace @truevine/api -- production-test-rollout.e2e-spec.ts"
                },
    "devDependencies":  {
                            "@eslint/js":  "10.0.1",
                            "@types/node":  "24.19.1",
                            "concurrently":  "10.0.5",
                            "eslint":  "10.12.0",
                            "eslint-config-next":  "16.4.2",
                            "eslint-config-prettier":  "10.1.8",
                            "globals":  "17.13.0",
                            "prettier":  "3.9.9",
                            "typescript":  "6.0.3",
                            "typescript-eslint":  "8.71.1",
                            "vitest":  "5.0.3"
                        },
    "allowScripts":  {
                         "prisma@7.10.1":  true,
                         "@prisma/engines@7.10.1":  true,
                         "unrs-resolver@1.12.2":  true,
                         "msgpackr-extract@3.0.4":  true
                     },
    "overrides":  {
                      "shell-quote":  "1.12.0"
                  }
}
