[Unit]
Description=Truevine Voice private MinIO object storage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minio
Group=minio
EnvironmentFile=/etc/truevine/minio.env
ExecStart=/usr/local/bin/minio server /var/lib/truevine-voice/minio --address 127.0.0.1:9000 --console-address 127.0.0.1:9001
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/truevine-voice/minio

[Install]
WantedBy=multi-user.target
