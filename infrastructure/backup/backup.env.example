# /etc/truevine/backup.env — created only on the VPS, never committed.
BACKUP_KEYFILE=/etc/truevine/backup.key
BACKUP_STORE=s3
BACKUP_BUCKET=<backup-bucket-name>
BACKUP_S3_ENDPOINT=<optional-s3-compatible-endpoint>
BACKUP_KEY_PREFIX=prod/postgres
BACKUP_CONFIG_PREFIX=prod/config
BACKUP_LOG_FILE=/var/log/truevine-backup.log
BACKUP_STATUS_FILE=/var/lib/truevine-backup/status.json
BACKUP_WORK_DIR=
BACKUP_PG_CONTAINER=truevine-postgres
BACKUP_PG_DB=truevine_voice
BACKUP_PG_ROLE=truevine
BACKUP_APP_ROOT=/var/www/TruevineVoice
BACKUP_CONFIG_SOURCE=/var/www/TruevineVoice
# BACKUP_LOCAL_DIR is used only for local simulation.
