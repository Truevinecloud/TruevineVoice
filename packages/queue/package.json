{
  "name": "@truevine/queue",
  "version": "0.1.0",
  "private": true,
  "description": "Redis connection and BullMQ foundation for Truevine Voice background processing",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
