    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@truevine/shared": "0.1.0",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
