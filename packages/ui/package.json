{
  "name": "@truevine/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design-system components for Truevine Voice frontends",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./design-tokens": {
      "types": "./dist/design-tokens.d.ts",
      "default": "./dist/design-tokens.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
