/// Platform-owned payment-provider credentials (MTN MoMo / Airtel Money).
///
/// NOT TENANT-OWNED. A payment provider account belongs to Truevine, not to a
/// customer organization, so this table has no `organization_id` and no
/// customer-facing endpoint may reach it.
///
/// SECRETS AT REST
/// ---------------
/// The credential values are stored only as an AES-256-GCM envelope produced by
/// `AesPaymentCredentialCipher`. `credentials_ciphertext` includes the nonce,
/// authentication tag and ciphertext; the additional authenticated data binds
/// the envelope to `provider` and `environment`, so a row cannot be copied to
/// another provider or environment and still decrypt. The key comes from
/// `PAYMENT_CREDENTIAL_ENCRYPTION_KEY` and has no default. `credential_fields`
/// holds names only, which is what lets the API report "configured" without
/// decrypting or returning a value.
///
/// ACTIVATION IS NOT IMPLIED BY CONFIGURATION
/// ------------------------------------------
/// A row becomes `active` only through the explicit activation endpoint. The
/// database repeats that rule with a CHECK constraint (active requires an
/// encrypted credential set and a callback URL) and a partial unique index
/// allowing at most one active environment per provider. Credential updates on
/// an active row are refused by the store, so replacing a secret cannot leave a
/// live configuration silently using a half-reviewed value.
model PaymentProviderConfiguration {
  id String @id @default(uuid()) @db.Uuid

  provider    PaymentProvider
  environment PaymentProviderEnvironment

  /// AES-256-GCM envelope. Null until the first credential save.
  credentialsCiphertext String? @map("credentials_ciphertext") @db.Text
  /// Credential field names only, never values. Used for redacted metadata.
  credentialFields      String[] @default([]) @map("credential_fields")

  /// Provider callback endpoint, if configured. Validated as an HTTPS URL with
  /// no query string or fragment so it cannot carry a routing token.
  callbackUrl String? @map("callback_url") @db.VarChar(512)

  active        Boolean   @default(false)
  configuredAt  DateTime? @map("configured_at") @db.Timestamptz(3)
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(3)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)

  /// Optimistic concurrency. A save carries the version it read; a concurrent
  /// change fails instead of overwriting the other operator's credentials.
  version Int @default(1)

  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User @relation("PaymentProviderConfiguredBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([provider, environment])
  @@index([provider, active])
  @@map("payment_provider_configurations")
}

/// PostgreSQL BYTEA audio storage. One blob per audio asset, org-scoped.
model AudioBlob {
  organizationId String   @map("organization_id") @db.Uuid
  id             String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId        String   @map("asset_id") @db.Uuid
  content        Bytes
  contentType    String   @map("content_type") @db.VarChar(64)
  byteSize       BigInt   @map("byte_size") @db.BigInt
  checksumSha256 String   @map("checksum_sha256") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  asset        AudioAsset @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, id])
  @@unique([organizationId, assetId])
  @@index([organizationId, byteSize], map: "idx_audio_blobs_org_size")
  @@map("audio_blobs")
}

/// Per-organization audio storage quotas.
model OrganizationAudioQuota {
  organizationId     String   @id @map("organization_id") @db.Uuid
  maxTotalBytes      BigInt   @default(52428800) @map("max_total_bytes") @db.BigInt
  maxSingleFileBytes BigInt   @default(5242880) @map("max_single_file_bytes") @db.BigInt
  maxFiles           Int      @default(100) @map("max_files")
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedByUserId    String?  @map("updated_by_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updatedBy    User?      @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("organization_audio_quota")
}

/// Tenant-created custom role within one organization.
model CustomRole {
  organizationId String      @map("organization_id") @db.Uuid
  id             String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String      @db.VarChar(120)
  description    String?
  type           RoleType    @default(CUSTOM)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @map("updated_at") @db.Timestamptz(3) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "custom_roles_organization_exists")
  permissions  RolePermission[]
  assignments  RoleAssignment[]

  @@id([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, type])
  @@map("custom_roles")
}

/// Permission granted to a custom role.
model RolePermission {
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permission     String @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role CustomRole @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, roleId, permission])
  @@index([organizationId, roleId])
  @@map("role_permissions")
}

/// Assignment of a custom role to a member.
model RoleAssignment {
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role    CustomRole   @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)
  member  Membership   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@id([organizationId, roleId, userId])
  @@index([organizationId, userId])
  @@map("role_assignments")
}

/// Durable reconciliation state for a paid call initiation. Rows are immutable
/// in identity and follow a guarded state machine in PostgreSQL.
model CallInitiationReconciliation {
  organizationId        String                             @map("organization_id") @db.Uuid
  attemptId             String                             @map("attempt_id") @db.Uuid
  status                CallInitiationReconciliationStatus @default(NOT_STARTED)
  reconciliationRequired Boolean                           @default(true) @map("reconciliation_required")
  createdAt             DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                           @default(now()) @map("updated_at") @db.Timestamptz(3)

  attempt CallAttempt @relation(fields: [organizationId, attemptId], references: [organizationId, id], onUpdate: NoAction, map: "call_initiation_reconciliations_attempt_fkey")

  @@id([organizationId, attemptId])
  @@index([organizationId, reconciliationRequired, updatedAt], map: "call_initiation_reconciliations_required_idx")
  @@map("call_initiation_reconciliations")
}

/// Non-ledger budget reservation held for one dispatch attempt. A reservation
/// is evidence for a spending decision; only wallet entries move money.
model CampaignDispatchReservation {
  organizationId String   @map("organization_id") @db.Uuid
  id             String   @db.Uuid
  attemptId      String   @map("attempt_id") @db.Uuid
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @db.VarChar(3)
  state          String   @default("HELD") @db.VarChar(16)
  policyVersion  String   @map("policy_version") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  attempt CallAttempt @relation(fields: [organizationId, attemptId], references: [organizationId, id], onUpdate: NoAction, map: "campaign_dispatch_reservations_attempt_fkey")

  @@id([organizationId, id])
  @@unique([organizationId, attemptId], map: "campaign_dispatch_reservations_attempt_key")
  @@index([organizationId, state], map: "campaign_dispatch_reservations_state_idx")
  @@map("campaign_dispatch_reservations")
}

/// One logical SMS fallback per campaign recipient. The voice attempt is kept
/// for traceability but is not part of the uniqueness key.
model SmsFallbackOperation {
  organizationId    String   @map("organization_id") @db.Uuid
  id                String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId        String   @map("campaign_id") @db.Uuid
  recipientId       String   @map("recipient_id") @db.Uuid
  voiceAttemptId    String   @map("voice_attempt_id") @db.Uuid
  phoneE164         String   @map("phone_e164") @db.VarChar(16)
  message           String
  idempotencyKey    String   @map("idempotency_key") @db.VarChar(200)
  status            String   @default("PENDING") @db.VarChar(16)
  providerReference String?  @map("provider_reference") @db.VarChar(200)
  reconciled        Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  campaign   Campaign          @relation(fields: [organizationId, campaignId], references: [organizationId, id], map: "sms_fallback_operations_org_campaign_id_fkey")
  organization Organization   @relation(fields: [organizationId], references: [id], map: "sms_fallback_operations_org_organization_id_fkey")
  recipient  CampaignRecipient @relation(fields: [organizationId, recipientId], references: [organizationId, id], map: "sms_fallback_operations_org_recipient_id_fkey")
  voiceAttempt CallAttempt     @relation(fields: [organizationId, voiceAttemptId], references: [organizationId, id], map: "sms_fallback_operations_org_voice_attempt_id_fkey")

  @@id([organizationId, id])
  @@unique([organizationId, campaignId, recipientId], map: "sms_fallback_operations_org_campaign_recipient_key")
  @@index([organizationId, status, createdAt], map: "sms_fallback_operations_org_status_created_idx")
  @@map("sms_fallback_operations")
}

/// Links an untrusted provider callback to the tenant call attempt it proves.
model VoiceCallbackBinding {
  source         String @db.VarChar(64)
  sessionId      String @map("session_id") @db.VarChar(160)
  organizationId String @map("organization_id") @db.Uuid
  attemptId      String @map("attempt_id") @db.Uuid

  attempt CallAttempt     @relation(fields: [organizationId, attemptId], references: [organizationId, id], onUpdate: NoAction, map: "voice_callback_bindings_organization_id_attempt_id_fkey")
  quotes  VoiceUsageQuote[]
  events  VoiceUsageEvent[]

  @@id([source, sessionId])
  @@unique([source, sessionId, organizationId, attemptId], map: "voice_callback_bindings_full_key")
  @@map("voice_callback_bindings")
}

/// Durable, immutable record of a processed provider callback receipt.
model VoiceCallbackReceipt {
  id             String           @id @db.Uuid
  source         String           @db.VarChar(64)
  sessionId      String           @map("session_id") @db.VarChar(160)
  eventKey       String           @map("event_key") @db.VarChar(64)
  requestedState CallAttemptState @map("requested_state")
  occurredAt     DateTime         @map("occurred_at") @db.Timestamptz(3)
  receivedAt     DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  nextRunAt      DateTime         @default(now()) @map("next_run_at") @db.Timestamptz(3)
  attempts       Int              @default(0)
  status         String           @default("pending") @db.VarChar(16)
  outcome        String?          @db.VarChar(32)

  @@unique([source, eventKey])
  @@index([source, sessionId, status], map: "voice_callback_receipts_binding_idx")
  @@index([status, nextRunAt, id], map: "voice_callback_receipts_due_idx")
  @@map("voice_callback_receipts")
}

/// Platform-owned provider status. Credentials are encrypted at rest and no
/// customer-facing endpoint may read this table.
model VoiceProviderConfiguration {
  environment  String    @id @db.VarChar(10)
  username     String    @db.VarChar(128)
  voiceNumber  String    @map("voice_number") @db.VarChar(16)
  ciphertext   String
  enabled      Boolean   @default(false)
  checkedAt    DateTime? @map("checked_at") @db.Timestamptz(3)
  checkResult  String?   @map("check_result") @db.VarChar(11)
  version      Int       @default(1)

  @@map("voice_provider_configurations")
}

/// Immutable price quote for one completed call. Customer charge is exact
/// integer minor units; provider cost is evidence, never a chargeable amount.
model VoiceUsageQuote {
  organizationId        String   @map("organization_id") @db.Uuid
  id                    String   @db.Uuid
  source                String   @db.VarChar(64)
  sessionId             String   @map("session_id") @db.VarChar(160)
  attemptId             String   @map("attempt_id") @db.Uuid
  billedSeconds         Int      @map("billed_seconds")
  ratePerSecondMinor    BigInt   @map("rate_per_second_minor")
  customerChargeMinor   BigInt   @map("customer_charge_minor")
  currency              String   @db.VarChar(3)
  providerCostMinor     BigInt?  @map("provider_cost_minor")
  providerCostCurrency  String?  @map("provider_cost_currency") @db.VarChar(3)
  pricingVersion        String   @map("pricing_version") @db.VarChar(64)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], map: "voice_usage_quotes_organization_fkey")
  binding      VoiceCallbackBinding @relation(fields: [source, sessionId, organizationId, attemptId], references: [source, sessionId, organizationId, attemptId], map: "voice_usage_quotes_binding_fkey")
  event        VoiceUsageEvent?

  @@id([organizationId, id])
  @@unique([organizationId, attemptId], map: "voice_usage_quotes_attempt_key")
  @@unique([source, sessionId], map: "voice_usage_quotes_session_key")
  @@index([organizationId, createdAt, id], map: "voice_usage_quotes_organization_created_idx")
  @@map("voice_usage_quotes")
}

/// Immutable settlement event. The paired wallet debit is the only balance
/// change; this row is the evidence that authorises and reconciles that debit.
model VoiceUsageEvent {
  organizationId        String           @map("organization_id") @db.Uuid
  id                    String           @db.Uuid
  attemptId             String           @map("attempt_id") @db.Uuid
  source                String           @db.VarChar(64)
  sessionId             String           @map("session_id") @db.VarChar(160)
  receiptEventKey       String           @map("receipt_event_key") @db.VarChar(64)
  quoteId               String           @map("quote_id") @db.Uuid
  debitEntryId          String           @map("debit_entry_id") @db.Uuid
  billedSeconds         Int              @map("billed_seconds")
  ratePerSecondMinor    BigInt           @map("rate_per_second_minor")
  customerChargeMinor   BigInt           @map("customer_charge_minor")
  currency              String           @db.VarChar(3)
  providerCostMinor     BigInt?          @map("provider_cost_minor")
  providerCostCurrency  String?          @map("provider_cost_currency") @db.VarChar(3)
  pricingVersion        String           @map("pricing_version") @db.VarChar(64)
  state                 CallAttemptState
  occurredAt            DateTime         @map("occurred_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  binding   VoiceCallbackBinding @relation(fields: [source, sessionId, organizationId, attemptId], references: [source, sessionId, organizationId, attemptId], map: "voice_usage_events_binding_fkey")
  debit     WalletEntry          @relation(fields: [organizationId, debitEntryId], references: [organizationId, id], map: "voice_usage_events_debit_fkey")
  quote     VoiceUsageQuote      @relation(fields: [organizationId, quoteId], references: [organizationId, id], map: "voice_usage_events_quote_fkey")
  reversal  VoiceUsageReversal?

  @@id([organizationId, id])
  @@unique([organizationId, receiptEventKey], map: "voice_usage_events_event_key_key")
  @@unique([organizationId, quoteId], map: "voice_usage_events_quote_key")
  @@unique([source, receiptEventKey], map: "voice_usage_events_source_event_key_key")
  @@index([organizationId, createdAt, id], map: "voice_usage_events_organization_created_idx")
  @@map("voice_usage_events")
}

/// Immutable compensating record for a settled call. The paired wallet credit
/// is an append-only ledger entry; historical settlement rows are never edited.
model VoiceUsageReversal {
  organizationId String   @map("organization_id") @db.Uuid
  id             String   @db.Uuid
  usageEventId   String   @map("usage_event_id") @db.Uuid
  creditEntryId  String   @map("credit_entry_id") @db.Uuid
  reason         String   @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  usage  VoiceUsageEvent @relation(fields: [organizationId, usageEventId], references: [organizationId, id], map: "voice_usage_reversals_usage_fkey")
  credit WalletEntry     @relation(fields: [organizationId, creditEntryId], references: [organizationId, id], map: "voice_usage_reversals_credit_fkey")

  @@id([organizationId, id])
  @@unique([organizationId, usageEventId], map: "voice_usage_reversals_usage_key")
  @@map("voice_usage_reversals")
}
