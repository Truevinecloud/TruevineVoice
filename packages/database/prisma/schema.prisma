// ---------------------------------------------------------------------------
// Truevine Voice - PostgreSQL schema
//
// IDENTITY AND AUTHORIZATION FOUNDATION (added 2026-10-16, ADR 0009).
//
// Present: Organization, Membership, and the identity and authorization tables
// RBAC-001 requires - User, Session, PasswordResetToken, TermsAcceptance,
// Invitation, PlatformRoleAssignment and SecurityAuditEvent.
//
// Membership remains the tenancy anchor: it is what makes an organizationId a
// real relationship rather than a loose column.
//
// CAMPAIGNS (added 2026-10-19, RBAC-003). A tenant-owned resource
// beyond the tenancy core itself. It exists so the CAMPAIGN_MANAGER role has
// something real to exercise: the permission registry already carried
// `campaign:*`, but a permission with no endpoint is untested by construction.
// CONTACTS/GROUPS (W2-02) extend the existing campaign Contact model. Its
// destination, label, IDs and recipient relationships remain authoritative;
// nullable W2 fields leave legacy campaign-only rows intact.
//
// Billing (RBAC-004) includes an append-only UGX wallet ledger and durable
// top-up requests only; it does not collect payments or settle wallet balances.
// Voice, SMS, WhatsApp and provider-specific data remain absent.
//
// DEPLOYMENT INTERLOCK
// -------------------
// `infrastructure/scripts/deploy.mjs#assertReviewedMigrations` refuses to deploy
// any tree containing a migration directory not listed in
// `infrastructure/migrations-reviewed.json`. Every migration below therefore
// blocks production deployment until a human reviews its SQL, backward
// compatibility, rollback and execution plan, and lists it there. See ADR 0006
// for the pattern and ADR 0009 for the RBAC-001 migration specifically.
//
// PostgreSQL is the system of record. Every tenant-owned table must be
// organization-scoped, and that scope must be enforced by the database rather
// than only by application code.
//
// Intentionally absent: `prisma-client-js` (deprecated in Prisma 7), views and
// `directUrl` (removed in Prisma 7).
// ---------------------------------------------------------------------------

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// What a principal may do inside one organization.
///
/// REPLACED 2026-10-16. The original vocabulary was `OWNER | ADMIN |
/// OPERATOR | VIEWER`, which ADR 0006 described as "intentionally coarse" and
/// explicitly deferred fine-grained permissions to a later decision. ADR 0009
/// makes that decision. `OPERATOR` became `CAMPAIGN_MANAGER`, whose name states
/// what it is for, and `BILLING` was added because billing authority must be
/// granted separately and therefore has to be expressible as a role.
///
/// The replacement happened while both tables were empty. After real data exists
/// the same change becomes a data migration, which is why it was done now.
///
/// `OWNER` is still never granted implicitly, and is not a delegable role
/// (`canDelegate` in @truevine/auth returns false for OWNER -> OWNER). Creating
/// an owner happens only through `ownership:transfer`, a deliberate audited act.
enum MembershipRole {
  OWNER
  ADMIN
  CAMPAIGN_MANAGER
  BILLING
  VIEWER
}

/// A role held inside the Truevine platform, outside every customer organization.
///
/// A separate enum from `MembershipRole` on purpose. Platform authority and
/// tenant authority must never be expressible in one row, and no customer-facing
/// endpoint may write this table.
enum PlatformRole {
  PLATFORM_OWNER
  OPERATIONS_ADMIN
  BILLING_ADMIN
  SUPPORT_ADMIN
  TECHNICAL_ADMIN
  AUDITOR
}

/// Whether an account may authenticate and act.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Which namespace an audit event was exercising.
enum AuditScope {
  ORGANIZATION
  PLATFORM
}

/// Whether an audited action was allowed or refused.
enum AuditOutcome {
  SUCCESS
  DENIED
}

/// A payment provider whose credentials platform Super Admins may configure.
///
/// Deliberately provider-specific rather than a generic "payment gateway" row:
/// MTN and Airtel do not share a credential contract, and one table with a
/// free-form JSON blob would let either provider's field names drift into the
/// other's. Adding a provider is a reviewed migration, not a data edit.
enum PaymentProvider {
  MTN_MOMO
  AIRTEL_MONEY
}

/// Whether a credential set targets the provider's sandbox or live environment.
///
/// Kept separate from `PaymentProvider` because the same provider needs two
/// independent credential sets. Activation is per environment, and the
/// database permits at most one active environment per provider.
enum PaymentProviderEnvironment {
  SANDBOX
  PRODUCTION
}

/// A person who can authenticate.
///
/// NOT TENANT-OWNED. A user is an identity, not an organization resource: the
/// same person may belong to several organizations with independent roles.
/// Keying identity tables by `organizationId` would make that impossible. The
/// ADR 0006 organization-scoping rule applies to *tenant-owned* rows, which is
/// why Membership, Invitation and SecurityAuditEvent are organization-scoped and
/// these are not.
model User {
  id    String     @id @default(uuid()) @db.Uuid
  /// Normalised login identifier. `citext` makes uniqueness case-insensitive in
  /// the database, so `Alice@x.com` cannot become a second account for
  /// `alice@x.com` even if a caller skips normalisation.
  email        String     @unique @db.Citext
  /// Argon2id encoded hash. Never reversible, never logged, never serialised
  /// into a response. Named `passwordHash` rather than `password` so a careless
  /// `select *` into a response body cannot ship it under an obvious name.
  passwordHash String     @map("password_hash") @db.Text
  status       UserStatus @default(ACTIVE)
  /// Consecutive failed sign-ins, reset on success. Feeds `lockedUntil`.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  /// Set when `failedLoginCount` trips the threshold; cleared on success.
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Drives "your password changed, sign in again", and invalidates sessions
  /// issued before the change.
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          Membership[]
  sessions             Session[]
  supportAccessSessions SupportAccessSession[] @relation("SupportAccessActor")
  passwordResetTokens  PasswordResetToken[]
  termsAcceptances     TermsAcceptance[]
  platformRole         PlatformRoleAssignment?    @relation("PlatformRoleHolder")
  platformRoleGranted  PlatformRoleAssignment[]   @relation("PlatformRoleGrantedBy")
  invitationsSent      Invitation[]                @relation("InvitationInviter")
  invitationsAccepted  Invitation[]                @relation("InvitationAcceptedBy")
  auditEvents          SecurityAuditEvent[]
  identityAuditEvents  IdentityAuditEvent[]
  platformOwnerBootstrap PlatformOwnerBootstrap?
  campaignsCreated     Campaign[]
  paymentProviderConfigurations PaymentProviderConfiguration[] @relation("PaymentProviderConfiguredBy")
  organizationAudioQuotas OrganizationAudioQuota[]

  @@map("users")
}

/// A signed-in session.
///
/// NOT TENANT-OWNED, and deliberately not pinned to an organization. The session
/// proves *who* the caller is. Which organization they are acting in comes from
/// the request and is validated against a membership every time. Pinning an
/// organization into the session would let a stale cookie act in a tenant the
/// user has since left.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// SHA-256 of the session token. The raw token exists only in the client
  /// cookie, so a database disclosure yields no usable credential.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  /// Rotated on every refresh. Presenting a superseded token is treated as theft
  /// and revokes the family.
  previousTokenHash String?  @map("previous_token_hash") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Why the session ended. Null means "expired naturally".
  revokedReason     String?  @map("revoked_reason") @db.VarChar(64)
  /// Hash, not the raw value: a user agent is personal data.
  userAgentHash    String?  @map("user_agent_hash") @db.VarChar(64)
  /// Truncated to /24 so a log line cannot reconstruct a full address.
  ipPrefix         String?  @map("ip_prefix") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  supportAccessSessions SupportAccessSession[]

  @@index([userId])
  @@unique([userId, id])
  @@index([expiresAt])
  @@map("sessions")
}

/// A single-use password-reset token.
///
/// `usedAt` is what makes reset safe. Completing a reset sets it atomically; a
/// second presentation finds it already set and is refused. Without it, whoever
/// saw the link could use it after the legitimate recipient had.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Proof that a user accepted a given version of the terms.
///
/// Keyed by (user, version) rather than holding one "current" row, so accepting
/// version 2 does not erase that version 1 was accepted, and so publishing new
/// terms requires a fresh acceptance instead of silently inheriting the old one.
model TermsAcceptance {
  userId       String   @map("user_id") @db.Uuid
  termsVersion String   @map("terms_version") @db.VarChar(32)
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ipPrefix     String?  @map("ip_prefix") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, termsVersion])
  @@map("terms_acceptances")
}

/// Platform authority held by one user.
///
/// NOT TENANT-OWNED: a platform operator belongs to Truevine, not to a customer.
/// `userId` is the whole primary key, so a user holds at most one platform role.
/// That removes the "which platform role applies?" ambiguity a many-to-many join
/// table would introduce, for a team small enough that the trade is worth it.
model PlatformRoleAssignment {
  userId          String       @map("user_id") @db.Uuid
  role            PlatformRole
  grantedByUserId String?      @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime     @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(3)

  user          User  @relation("PlatformRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("PlatformRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([userId])
  @@index([role])
  @@map("platform_role_assignments")
}

/// Platform-owned, immutable first-owner claim. The fixed slot is SQL-constrained;
/// it never reopens when an owner is revoked. See ADR 0014.
model PlatformOwnerBootstrap {
  slot String @id @db.VarChar(32)
  operationId String @unique @map("operation_id") @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  auditEventId String @unique @map("audit_event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditEvent IdentityAuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("platform_owner_bootstrap")
}

/// TENANT-OWNED. ADR 0006 rule: the primary key leads with `organization_id`, so
/// a row cannot exist without an organization.
///
/// An invitation to join one organization. `tokenHash` is stored, never the raw
/// token: the emailed link holds the only copy. Expired, accepted and revoked are
/// timestamps rather than a status enum, so "revoked after acceptance" stays
/// distinguishable from "revoked before acceptance".
model Invitation {
  organizationId  String         @map("organization_id") @db.Uuid
  id              String         @default(uuid()) @db.Uuid
  email           String         @db.Citext
  role            MembershipRole
  tokenHash       String         @unique @map("token_hash") @db.VarChar(64)
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?       @map("accepted_by_user_id") @db.Uuid
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@id([organizationId, id])
  @@index([email])
  @@map("invitations")
}

/// The identity half of the security audit trail: sign-in, sign-out, password
/// reset, terms acceptance and session revocation.
///
/// A SEPARATE TABLE, and that is the whole point of it. Those events are about a
/// person, not a tenant: "Alice signed in at 09:14" does not belong to any
/// organization, and attributing it to one would be a fabrication. Forcing it
/// into the organization-scoped table would have meant either a nullable
/// `organization_id` - which breaks ADR 0006's composite-key rule for every
/// tenant-owned table - or duplicating the event once per membership, which
/// invents a tenant association that never existed.
///
/// Neither was acceptable, so identity events get their own append-only table.
/// ADR 0006's rule is intact because this table is not tenant-owned, for the
/// same reason `users` is not.
model IdentityAuditEvent {
  id          String       @default(uuid()) @db.Uuid
  actorUserId String       @map("actor_user_id") @db.Uuid
  action      String       @db.VarChar(64)
  outcome     AuditOutcome
  /// Never a credential, never a password, never key material. Enforced by the
  /// writer against a forbidden-key list, and asserted for each known writer.
  metadata    Json         @default("{}")
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  /// `RESTRICT`, not `CASCADE`.
  ///
  /// The append-only trigger would block a cascading delete anyway - a user with
  /// an audit trail cannot be deleted either way - so declaring `CASCADE` here
  /// would document an action that can never happen. `RESTRICT` states the real
  /// intent and fails with a clear constraint error.
  ///
  /// CONSEQUENCE, which the team must decide on: there is no user-deletion path
  /// at all. A right-to-erasure request therefore needs a reviewed procedure -
  /// most likely anonymising the user rather than deleting it - and RBAC-001 does
  /// not implement one. Flagged in ADR 0009 rather than left to be discovered.
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  platformOwnerBootstrap PlatformOwnerBootstrap?

  @@id([id])
  @@index([actorUserId])
  @@index([action])
  @@index([occurredAt])
  @@map("identity_audit_events")
}

/// A short-lived, server-validated read-only support capability. It preserves
/// the real platform administrator and is never a customer authentication
/// session. Only the token hash is persisted.
model SupportAccessSession {
  organizationId String    @map("organization_id") @db.Uuid
  id             String    @default(uuid()) @db.Uuid
  actorUserId    String    @map("actor_user_id") @db.Uuid
  authSessionId  String    @map("auth_session_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  reasonCode     String    @map("reason_code") @db.VarChar(32)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User         @relation("SupportAccessActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  authSession  Session      @relation(fields: [actorUserId, authSessionId], references: [userId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@index([actorUserId, authSessionId, expiresAt])
  @@map("support_access_sessions")
}

/// TENANT-OWNED. Append-only audit trail of organization and authorization actions.
///
/// IMMUTABILITY IS ENFORCED IN THE DATABASE, not by application discipline. The
/// application connects as the table owner, and an owner bypasses GRANT, so a
/// `REVOKE UPDATE, DELETE` would be decorative. The migration installs a BEFORE
/// UPDATE OR DELETE trigger that raises. That is the only mechanism that holds
/// against a careless future query, a direct psql session, or an ORM call nobody
/// reviewed.
///
/// Denials are recorded as well as successes. A trail containing only successes
/// cannot answer "was this an attack?".
///
/// `scope` records which namespace was exercised. An Organization Owner probing
/// platform administration produces a row scoped to their own organization with
/// `scope = PLATFORM` and `outcome = DENIED`. That keeps this table
/// organization-scoped and avoids a nullable `organization_id`, which would
/// weaken the ADR 0006 key rule.
model SecurityAuditEvent {
  organizationId String       @map("organization_id") @db.Uuid
  id             String       @default(uuid()) @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  /// Dotted verb, for example `organization.updated` or `platform.access.denied`.
  /// Deliberately a string rather than an enum: the set of audited actions grows
  /// with the product, and a new audit action must not require a migration. The
  /// values RBAC-001 emits are pinned by a test in @truevine/auth.
  action     String       @db.VarChar(64)
  scope      AuditScope
  outcome    AuditOutcome
  targetType String?      @map("target_type") @db.VarChar(64)
  targetId   String?      @map("target_id") @db.VarChar(64)
  /// Structured detail. Never credentials, never a password, never key material;
  /// the writers are responsible for that and a test asserts the known ones do
  /// not include any.
  metadata   Json         @default("{}")
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@index([actorUserId])
  @@index([action])
  @@index([occurredAt])
  @@map("security_audit_events")
}

/// What a principal may do inside one organization.
///
/// A principal is a row here per organization. The same person in two
/// organizations is two memberships with independent roles, which is what keeps
/// authorization a per-tenant decision rather than a global one.
///
/// TENANCY ENFORCEMENT
/// ------------------
/// `@@unique([userId, organizationId])` is the primary access path: resolving
/// "which organizations can this user act in?" leads with `userId`, and that
/// lookup must not be able to return a cross-organization pair. The composite
/// primary key `@@id([organizationId, userId])` makes the tenant scope part of
/// the row identity itself, so a row cannot exist without an organization and a
/// user cannot hold two roles in one organization.
///
/// Both constraints are deliberate and both are relied upon by later tables.
/// Every future tenant-owned table must repeat this shape: a composite key or
/// unique index that leads with `organization_id`, plus a foreign key that
/// carries the organization alongside the parent id. A bare foreign key to a
/// parent row in another tenant is a cross-tenant write waiting to happen.
///
/// `userId` now carries a foreign key to `users`. Until 2026-10-16 it did not:
/// the column existed but the database accepted a membership for a user that did
/// not exist. The table was empty, so adding the constraint was free.
/// Exactly one OWNER is enforced by the partial unique index and deferred
/// constraint triggers in 20261016170000_security_atomicity. Retain that SQL
/// when generating future migrations; a model-level unique would forbid all
/// non-Owner memberships in the same organization.
model Membership {
  // No `id`: the tenant scope and the principal together are the identity.
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topUpRequests TopUpRequest[]
  contactsCreated Contact[] @relation("ContactCreator")
  contactGroupsCreated ContactGroup[] @relation("ContactGroupCreator")
  contactImports ContactImport[] @relation("ContactImportStarter")
  contactConsentsVerified Contact[] @relation("ContactConsentVerifier")
  audioAssetsCreated AudioAsset[]
  audioAssetOperations AudioAssetOperation[]
  audioAssetUsage AudioAssetUsage[]
  roleAssignments RoleAssignment[]

  @@id([organizationId, userId])
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Lifecycle state of a campaign.
///
/// Minimal on purpose. RBAC-003 needs a state a Campaign Manager may move a
/// campaign through - draft, running, finished - so "create, run and manage"
/// is expressible over HTTP. Transition rules (which step may follow which) are
/// product logic and deliberately unconstrained here; constraining them is a
/// later decision, not an implied one.
enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum AudioAssetSource {
  RECORDING
  TTS
}

enum AudioAssetOperationState {
  PENDING
  COMPLETED
  FAILED
}

enum AudioAssetUsageAction {
  RECORDING_CREATED
  TTS_GENERATED
  CAMPAIGN_SELECTED
  PLAYBACK_LINK_ISSUED
}

/// TENANT-OWNED. A campaign belonging to exactly one organization.
///
/// Follows the Invitation shape: the composite primary key leads with
/// `organization_id` (ADR 0006), so a row cannot exist without an organization
/// and the tenant scope is part of the row's identity rather than a column a
/// query might forget. Every lookup takes the organization id from the
/// validated path, so a campaign id guessed from another tenant resolves to
/// nothing.
///
/// No money, no provider reference, no recipient data: those belong to the
/// wallet, telephony and contact models that are deliberately not introduced
/// yet. This table is the RBAC surface, not the product.
model Campaign {
  // No standalone `id` primary key: organization scope plus id is the identity,
  // exactly as for Membership and Invitation.
  organizationId String         @map("organization_id") @db.Uuid
  id             String         @default(uuid()) @db.Uuid
  /// 1-200 characters, validated in the service before the row is written.
  name           String         @db.VarChar(200)
  status         CampaignStatus @default(DRAFT)
  /// Preparation only. A saved schedule never creates an execution or dispatches work.
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)
  retryMaxAttempts Int @default(1) @map("retry_max_attempts")
  retryDelayMinutes Int @default(60) @map("retry_delay_minutes")
  /// Optional tenant-owned audio used by this campaign.
  audioOrganizationId String? @map("audio_organization_id") @db.Uuid
  audioAssetId String? @map("audio_asset_id") @db.Uuid
  /// Set by platform emergency stop. Customer role mutations cannot clear it.
  emergencyStoppedAt DateTime? @map("emergency_stopped_at") @db.Timestamptz(3)
  /// Durable dispatch state. Separate from the customer-facing status so an
  /// emergency stop cannot be undone by a stale status write.
  dispatchState String @default("RUNNING") @map("dispatch_state") @db.VarChar(16)
  dispatchEpoch Int @default(0) @map("dispatch_epoch")
  pausedAt DateTime? @map("paused_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  dispatchStopReason String? @map("dispatch_stop_reason") @db.VarChar(40)
  /// W5-04 SMS fallback is disabled until both the organization and campaign
  /// opt in. Unknown contact consent denies dispatch.
  smsFallbackEnabled Boolean @default(false) @map("sms_fallback_enabled")
  smsFallbackMessage String? @map("sms_fallback_message")
  /// Provenance. `RESTRICT` rather than `SET NULL`: a campaign without a
  /// recorded creator is not a state this codebase can produce, and no
  /// user-deletion path exists that would need the softer constraint.
  createdById    String         @map("created_by_user_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]
  executions CampaignExecution[]
  audienceGroups CampaignAudienceGroup[]
  audioAsset AudioAsset? @relation(fields: [audioOrganizationId, audioAssetId], references: [organizationId, id], onDelete: Restrict)
  audioUsageEvents AudioAssetUsage[]
  smsFallbacks SmsFallbackOperation[]
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, dispatchState], map: "campaigns_dispatch_state_idx")
  @@map("campaigns")
}

/// The unit of tenancy. Every other tenant-owned row hangs off exactly one of
/// these.
///
/// `slug` is the stable, URL-safe public identifier used to address an
/// organization in routing and in provisioning lookups. It is unique and
/// immutable in practice: changing it breaks customer bookmarks and any
/// provider reference captured against it. `name` is the mutable label.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(63)
  name      String   @db.VarChar(200)
  /// When the organization was suspended, or null while it is active.
  ///
  /// Reversible by clearing the column. A destructive closure is not available:
  /// once an organization has audit events the append-only trigger refuses to
  /// delete it (ADR 0009), so "delete" would fail for exactly the organizations
  /// most likely to need closing.
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)
  /// Platform-admin-granted W5-04 entitlement. Disabled by default; campaign
  /// fallback cannot be enabled until this is true.
  smsEntitled Boolean @default(false) @map("sms_entitled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        Membership[]
  invitations        Invitation[]
  securityAuditEvents SecurityAuditEvent[]
  supportAccessSessions SupportAccessSession[]
  contacts           Contact[]
  campaigns          Campaign[]
  walletEntries      WalletEntry[]
  paymentIntents     PaymentIntent[]
  paymentAttempts    PaymentAttempt[]
  paymentProviderEvents PaymentProviderEvent[]
  topUpRequests      TopUpRequest[]
  billingProfile     BillingProfile?
  contactGroups      ContactGroup[]
  contactImports     ContactImport[]
  audioAssets AudioAsset[]
  audioAssetOperations AudioAssetOperation[]
  audioAssetUsage AudioAssetUsage[]
  audioBlobs AudioBlob[]
  audioQuota OrganizationAudioQuota?
  customRoles CustomRole[]
  smsFallbacks SmsFallbackOperation[]
  voiceUsageQuotes VoiceUsageQuote[]

  @@map("organizations")
}

/// Tenant-owned metadata for a private audio object. Raw bytes live only in
/// private S3-compatible storage, never in PostgreSQL or public web paths.
model AudioAsset {
  organizationId String @map("organization_id") @db.Uuid
  id String @default(uuid()) @db.Uuid
  createdById String @map("created_by_user_id") @db.Uuid
  name String @db.VarChar(120)
  source AudioAssetSource
  mimeType String @map("mime_type") @db.VarChar(64)
  storageKey String @map("storage_key") @db.VarChar(512)
  checksumSha256 String @map("checksum_sha256") @db.Char(64)
  byteSize BigInt @map("byte_size")
  durationMs Int? @map("duration_ms")
  ttsProvider String? @map("tts_provider") @db.VarChar(64)
  ttsVoice String? @map("tts_voice") @db.VarChar(64)
  ttsCharacterCount Int? @map("tts_character_count")
  storageBackend AudioStorageBackend @map("storage_backend") @default(S3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator Membership @relation(fields: [organizationId, createdById], references: [organizationId, userId], onDelete: Restrict)
  campaigns Campaign[]
  operations AudioAssetOperation[]
  usage AudioAssetUsage[]
  audioBlobs AudioBlob[]
  @@id([organizationId, id])
  @@unique([organizationId, storageKey])
  @@index([organizationId, createdAt, id])
  @@map("audio_assets")
}

/// Durable operation keys prevent a repeated TTS request from charging the
/// provider twice. The request fingerprint excludes (and never stores) text.
model AudioAssetOperation {
  organizationId String @map("organization_id") @db.Uuid
  id String @default(uuid()) @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)
  createdById String @map("created_by_user_id") @db.Uuid
  source AudioAssetSource
  requestFingerprint String @map("request_fingerprint") @db.Char(64)
  state AudioAssetOperationState @default(PENDING)
  assetOrganizationId String? @map("asset_organization_id") @db.Uuid
  assetId String? @map("asset_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator Membership @relation(fields: [organizationId, createdById], references: [organizationId, userId], onDelete: Restrict)
  asset AudioAsset? @relation(fields: [assetOrganizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  @@id([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, state, createdAt])
  @@map("audio_asset_operations")
}

/// Append-only usage accounting for creation and authorized playback access.
model AudioAssetUsage {
  organizationId String @map("organization_id") @db.Uuid
  id String @default(uuid()) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  action AudioAssetUsageAction
  byteSize BigInt @map("byte_size")
