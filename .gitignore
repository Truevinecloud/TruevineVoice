# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Test output
coverage/
.nyc_output/

# Environment / secrets - never commit real values
.env
.env.*
!.env.example

# Generated Prisma client (regenerate with `npm run prisma:generate`)
packages/database/src/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Misc
.vercel/
.cache/
# Production deployment state (server-local only)
/incoming/
/releases/
/current
/current.*
/deployment.json
/.deployment.lock
/REVISION
/READY
/.deployment-validation/

# RBAC-001 rehearsal working directory (disposable; created and removed by the
# rehearsal script, and never committed even if a run is interrupted).
/.rbac-rehearsal/

# Operator provisioning: holds single-use activation tokens (0600).
.owner-activation/
qa-owner-recovery-*.txt
.email-capture/
