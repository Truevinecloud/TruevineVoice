# ---------------------------------------------------------------------------
# Truevine Voice - local development environment
#
# Copy this file to `.env` at the repository root:
#
#   cp .env.example .env          # macOS / Linux / Git Bash
#   Copy-Item .env.example .env   # Windows PowerShell
#
# SECURITY: `.env` is gitignored and MUST never be committed. Only non-secret
# local development placeholders belong in `.env.example`. Real credentials are
# supplied by the deployment platform's secret manager in every other
# environment.
# ---------------------------------------------------------------------------

# Shared ---------------------------------------------------------------------
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# POSTGRES_PORT is the HOST port that Docker Compose publishes. The container
# itself always listens on 5432 and that never changes.
#
# The default is 55432, deliberately NOT the conventional 5432: developer
# machines often already run another project's PostgreSQL on 5432, and a
# collision makes `npm run infra:up` fail. If you change this value you MUST
# change the port inside DATABASE_URL on the next line to match.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://truevine:truevine@localhost:55432/truevine_voice?schema=public

# Optional: only needed if the migration role cannot create databases.
# SHADOW_DATABASE_URL=postgresql://truevine:truevine@localhost:55432/truevine_voice_shadow?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# REDIS_PORT is the HOST port that Docker Compose publishes. The container itself
# always listens on 6379 and that never changes.
#
# The default is 56379, deliberately NOT the conventional 6379, for the same
# reason as PostgreSQL above. If you change this value you MUST change the port
# inside REDIS_URL on the next line to match.
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

# ---------------------------------------------------------------------------
# Changing the ports
# ---------------------------------------------------------------------------
# 1. Pick free host ports (for example with `netstat -ano | findstr :5432`).
# 2. Update POSTGRES_PORT / DATABASE_URL and REDIS_PORT / REDIS_URL here in
#    `.env`, keeping each pair consistent.
# 3. Run `npm run infra:down` then `npm run infra:up`.
#
# The infrastructure E2E tests assert that PostgreSQL really is the
# `truevine_voice` database and that Redis really is reachable on the port from
# REDIS_URL. Pointing the app at another project's infrastructure therefore
# fails the test loudly instead of passing by accident.

# API (NestJS) --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Milliseconds allowed per dependency when answering GET /health
HEALTH_CHECK_TIMEOUT_MS=2000

# Frontends -----------------------------------------------------------------
# The Next.js apps hardcode their ports in their own `package.json` scripts
# (web 3000, admin 3002) so that the scripts behave identically on Windows,
# macOS and Linux. See the README for how to change one.

# ---------------------------------------------------------------------------
# Intentionally NOT defined yet. These are added in later, separate steps
# once the corresponding behaviour is actually implemented:
#   - Authentication / session secrets
#   - Africa's Talking credentials
#   - Payment provider credentials
#   - Object storage credentials
# Never add real secrets here - this file is committed to git.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Frontend -> API (RBAC-001)
# ---------------------------------------------------------------------------
# Server-side address of the NestJS API. Used by Next.js Server Components and
# Route Handlers. NEVER a NEXT_PUBLIC_ value: that would put an internal
# address in the browser bundle.
TRUEVINE_API_URL=http://localhost:3001

# Browser-facing base path. Must be a path beginning with "/" so the browser
# only ever talks to one origin. Changing it to an absolute URL would require
# credentialed CORS and defeat the same-origin proxy.
NEXT_PUBLIC_API_URL=/api

# Base URL used when building password-reset and invitation links in email.
# Must be the address a customer actually visits, or their links 404.
WEB_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (RBAC-001)
# ---------------------------------------------------------------------------
# development = write each message to a directory, send nothing.
# http        = POST to EMAIL_ENDPOINT. Requires both values below.
# none        = record that a send was requested, send nothing.
#
# PENDING CONFIGURATION: no provider account exists and no provider credential
# may be committed. `http` is deliberately a hard startup failure without its
# configuration, because a deployment that believes it is sending password
# resets and is not is worse than one that refuses to start.
EMAIL_TRANSPORT=development
EMAIL_CAPTURE_DIRECTORY=./.email-capture
# EMAIL_ENDPOINT=https://api.example-provider.invalid/v1/send
# EMAIL_AUTHORIZATION_HEADER=Bearer <supplied-by-secret-manager>

# ---------------------------------------------------------------------------
# Operator provisioning (RBAC-001)
# ---------------------------------------------------------------------------
# Set only in a production shell to require --confirm-production before
# `npm run provision:owner` will run.
# PROVISION_PRODUCTION=false
